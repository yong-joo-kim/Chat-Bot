# apps/ml-worker/.env — 전부 선택값(개발명세서/설계서 §13). 복사해서 .env로 사용할 것.

ML_WORKER_HOST=0.0.0.0
ML_WORKER_PORT=8100

# "mock" 이면 실제 모델을 로드하지 않고 결정론적 해시 벡터를 반환한다(모델·GPU 없이 계약만 검증).
# 골든셋 스윕(eval/report/*.md)에서 확정된 1순위 모델이 기본값이다.
EMBEDDING_MODEL_ID=nlpai-lab/KURE-v1
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_PREFIX_RULE=noprefix
EMBEDDING_NORM_RULE=l2
EMBEDDING_MAX_SEQ_LENGTH=128
EMBEDDING_BATCH_MAX=64
MOCK_DIMENSION=64

# ── No.16 증강 생성 프로파일(ADR-0026 §5, DD-101) — 전부 선택값. embed(기본)에서는 무시된다.
# embed(기본) | augment | both. 운영 기본 구성은 프로세스 분리(별도 포트로 augment 인스턴스를
# 따로 띄운다) — both는 개발 편의용이며 대화 성능 예산을 보장하지 않는다.
ML_WORKER_ROLE=embed
# "mock"이면 실제 생성모델을 로드하지 않고 결정론적 에코 문장을 반환한다(계약만 검증).
# 실사용 모델은 eval/generation_candidates.py의 5지표 실측(후보 3종)으로 확정할 것 — 후보
# 선정 근거는 eval/report/generation-model-comparison.md 참고.
GENERATION_MODEL_ID=mock
GENERATION_MODEL_REVISION=main
GENERATION_DEVICE=cuda
GENERATION_MAX_NEW_TOKENS=512
GENERATION_TARGET_COUNT_MAX=60
GENERATION_SEEDS_MAX=20
