# apps/ml-worker/.env — 전부 선택값(개발명세서/설계서 §13). 복사해서 .env로 사용할 것.

ML_WORKER_HOST=0.0.0.0
ML_WORKER_PORT=8100

# "mock" 이면 실제 모델을 로드하지 않고 결정론적 해시 벡터를 반환한다(모델·GPU 없이 계약만 검증).
# 골든셋 스윕(eval/report/*.md)에서 확정된 1순위 모델이 기본값이다.
EMBEDDING_MODEL_ID=nlpai-lab/KURE-v1
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_PREFIX_RULE=noprefix
EMBEDDING_NORM_RULE=l2
EMBEDDING_MAX_SEQ_LENGTH=128
EMBEDDING_BATCH_MAX=64
MOCK_DIMENSION=64

# ── No.16 증강 생성 프로파일(ADR-0026 §5, DD-101) — 전부 선택값. embed(기본)에서는 무시된다.
# embed(기본) | augment | both. 운영 기본 구성은 프로세스 분리(별도 포트로 augment 인스턴스를
# 따로 띄운다) — both는 개발 편의용이며 대화 성능 예산을 보장하지 않는다.
ML_WORKER_ROLE=embed
# "mock"이면 실제 생성모델을 로드하지 않고 결정론적 에코 문장을 반환한다(계약만 검증).
# 실사용 모델은 eval/generation_candidates.py의 5지표 실측(후보 3종)으로 확정할 것 — 후보
# 선정 근거는 eval/report/generation-model-comparison.md 참고.
GENERATION_MODEL_ID=mock
GENERATION_MODEL_REVISION=main
GENERATION_DEVICE=cuda
# transformers 전용 기본 512. Ollama 경로에 이 키를 명시하면 OLLAMA_MAX_NEW_TOKENS 미설정 시 그 값이 쓰인다.
# GENERATION_MAX_NEW_TOKENS=512
GENERATION_TARGET_COUNT_MAX=60
GENERATION_SEEDS_MAX=20

# ── 생성 백엔드 선택(No.37 온디바이스/엣지 추론, ADR-0046) — 전부 선택값.
# transformers(기본, 위 GENERATION_* 그대로 — 동작 무변화)
# | ollama — 경량 설치 구성: 동작 보장·품질 미보증(4GB급 GPU 등 소형 장비). G3 후보 3종(8B~32B급,
#   L40S 실측 대상)의 대체가 아니며 운영 채택 판정은 No.17.
# | vllm — 생성 전용 사내 vLLM 서버(OpenAI 호환) 위탁, 운영 구성. 외부 RAG가 쓰는 vLLM을 공유하지 말 것.
# 그 외 값(오타 포함)은 생성 프로세스(ML_WORKER_ROLE=augment|both)의 기동 실패다.
GENERATION_BACKEND=transformers
# 기동 워밍업 1회 요청에만 적용(모델 적재 시간 흡수).
GENERATION_WARMUP_TIMEOUT_S=120
# 원격 백엔드 주소는 루프백·사설 대역만 허용한다(마스킹하지 않은 시드가 전송됨). 그 밖의 사내 주소는
# 콤마로 명시: host | host:port | *.suffix. REQUIRE_ALLOWLIST=true면 루프백·사설도 목록에 있어야 한다.
GENERATION_BACKEND_ALLOWED_HOSTS=
GENERATION_BACKEND_REQUIRE_ALLOWLIST=false

# -- ollama (경량 설치 구성)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# 원격 요청 시간 제한 — apps/api AUGMENTATION_TIMEOUT_MS(기본 30초)보다 먼저 포기하도록 25초.
# 30초를 넘기면 기동 경고. 예전 .env에 90이 남아 있으면 25로 고치세요.
OLLAMA_REQUEST_TIMEOUT_S=25
OLLAMA_CONNECT_TIMEOUT_S=5
# 미설정이면 GENERATION_MAX_NEW_TOKENS를 명시한 경우 그 값, 아니면 768.
# OLLAMA_MAX_NEW_TOKENS=768
# 1회 생성 상한(1~GENERATION_TARGET_COUNT_MAX). API가 더 많이 요청해도 이 값까지만 생성한다.
# 주의: 20 초과로 올리면 3050 실측상 25초 제한에 걸려 빈 결과(G1 폴백)가 될 수 있다.
# 미설정이면 min(20, GENERATION_TARGET_COUNT_MAX).
OLLAMA_TARGET_CAP=20

# -- vllm (운영 구성) — VLLM_BASE_URL·VLLM_MODEL은 GENERATION_BACKEND=vllm이면 필수.
# VLLM_BASE_URL은 서버 루트(끝에 /v1을 붙이지 않는다). VLLM_MODEL은 vLLM --served-model-name 값.
VLLM_BASE_URL=
VLLM_MODEL=
# 비밀값 — 로그·상태 응답에 노출되지 않는다. 인증 없는 사내 서버면 비워 둔다.
VLLM_API_KEY=
VLLM_REQUEST_TIMEOUT_S=25
VLLM_CONNECT_TIMEOUT_S=5
# 60건 배열 출발값 — No.17 운영 실측 후 확정.
VLLM_MAX_NEW_TOKENS=2048
# 미설정(주석 처리)이면 GENERATION_TARGET_COUNT_MAX를 따른다. 명시값이 그 상한을 넘으면 기동 실패.
# VLLM_TARGET_CAP=60

# ── No.32 음성 인식(ADR-0052) — ML_WORKER_ROLE=speech(배타 역할)에서만 읽힌다. 전부 선택값.
# 선택 의존성 설치: pip install -c requirements-lock.txt -c requirements-speech-lock.txt -e ".[dev,speech]"
# 이 역할은 임베딩·생성 모델을 적재하지 않는다(공개 STT 폭주가 대화 임베딩과 자원을 다투지 않도록 프로세스 분리).
# 알 수 없는 ML_WORKER_ROLE·STT_BACKEND 값, faster-whisper인데 STT_MODEL_ID 없음, CUDA 적재 실패는
# 음성 인식 프로세스만 기동 실패다(조용한 대체 없음).
# 주의: STT_BACKEND=mock은 시험·시연 전용이다. 운영 API(NODE_ENV=production)는 mock 백엔드 프로세스를
#       사용 불가로 본다(DD-135). mock이면 기동 경고가 1회 출력된다.
STT_BACKEND=mock
# faster-whisper면 필수(기본 모델 없음). 캐시 이름(예: large-v3-turbo) 또는 로컬 경로.
# 기동 중에는 내려받지 않는다(local_files_only 고정) — 모델은 scripts/fetch_stt_model.py로 사전 반입.
STT_MODEL_ID=
STT_MODEL_DIR=
# cpu | cuda (CUDA 적재 실패는 CPU로 조용히 대체하지 않고 기동 실패)
STT_DEVICE=cpu
# int8 | int8_float16 | float16 | float32
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=5
# 0 = 라이브러리 기본
STT_CPU_THREADS=0
# 대기 없는 세마포어(초과 시 즉시 503) · faster-whisper num_workers
STT_MAX_CONCURRENCY=2
STT_MAX_AUDIO_BYTES=1048576
# 디코딩 뒤 길이 상한(위젯 30초 + 여유 2)
STT_MAX_AUDIO_SECONDS=32
# 처리 상한. API SPEECH_STT_TIMEOUT_MS(기본 10초)보다 짧게 — 9초 초과는 기동 경고.
STT_DEADLINE_S=8.0
# auto(faster-whisper=silero, mock=energy) | silero | energy | off
STT_VAD=auto

# 프로세스 분리 예시(같은 코드, 다른 .env/환경변수):
#   음성:    ML_WORKER_ROLE=speech   ML_WORKER_PORT=8102  STT_BACKEND=faster-whisper STT_MODEL_ID=<캐시 이름|경로>
#   임베딩:  ML_WORKER_ROLE=embed    ML_WORKER_PORT=8100  EMBEDDING_DEVICE=cpu
#   생성:    ML_WORKER_ROLE=augment  ML_WORKER_PORT=8101  GENERATION_BACKEND=ollama|vllm
