# apps/ml-worker/.env — 전부 선택값(개발명세서/설계서 §13). 복사해서 .env로 사용할 것.

ML_WORKER_HOST=0.0.0.0
ML_WORKER_PORT=8100

# "mock" 이면 실제 모델을 로드하지 않고 결정론적 해시 벡터를 반환한다(모델·GPU 없이 계약만 검증).
# 골든셋 스윕(eval/report/*.md)에서 확정된 1순위 모델이 기본값이다.
EMBEDDING_MODEL_ID=nlpai-lab/KURE-v1
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_PREFIX_RULE=noprefix
EMBEDDING_NORM_RULE=l2
EMBEDDING_MAX_SEQ_LENGTH=128
EMBEDDING_BATCH_MAX=64
MOCK_DIMENSION=64
